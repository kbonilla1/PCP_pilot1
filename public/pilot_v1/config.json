{
    "$schema": "https://raw.githubusercontent.com/revisit-studies/study/main/src/parser/StudyConfigSchema.json",
    "studyMetadata": {
        "title": "Parallel Coordinate Plot Study Pilot v1",
        "version": "pilot1",
        "authors": [
            "Karen Bonilla"
        ],
        "date": "2026-01-25",
        "description": "A study on approaches to using parallel coordinate plots",
        "organizations": [
            "WPI"
        ]
    },
    "uiConfig": {
        "contactEmail": "kbonilla@wpi.edu",
        "helpTextPath": "pilot_v1/assets/help.md",
        "logoPath": "revisitAssets/revisitLogoSquare.svg",
        "withProgressBar": true,
        "autoDownloadStudy": false,
        "withSidebar": true
    },
    "components": {
        "introduction": {
            "type": "markdown",
            "path": "pilot_v1/assets/introduction.md",
            "response": []
        },
        "first-question-set": {
            "type": "image",
            "path": "pilot_v1/assets/PCP_hard.jpg",
            "instruction": "This parallel coordinate plot displays information from the 2004 US presidential election that includes records of voters’ demographics including the names of three political candidates. The data variables are presented as state name, candidates Bush, Kerry, and Nader, the total number of votes, rent in US Dollars, unemployment, and obesity rates. Which variable has an indirect correlation with the unemployment rate?",
            "style": {
                "width": "800px"
            },
            "nextButtonLocation": "sidebar",
            "response": [
                {
                    "id": "demo-image/assets-response",
                    "prompt": "Answer:",
                    "location": "sidebar",
                    "type": "radio",
                    "options": [
                        "Nader",
                        "Rent",
                        "M_Smoker",
                        "Obese",
                        "Not sure",
                        "None of the above"
                        ]
                    }
                ]
            },
        "second-question-set": {
            "type": "image",
            "path": "pilot_v1/assets/PCP_easy.jpg",
            "instruction": "The image shows information about coal-mining disasters for over a century. Each polyline represents one coal disaster with information such as a month of the accident, year of the accident, day of the year, intervals between coal mining disasters, and the number of deaths. Approximately, what is the range of values for the year attribute?",
            "style": {
                "width": "800px"
            },
            "nextButtonLocation": "sidebar",
            "response": [
                {
                    "id": "demo-image/assets-response",
                    "prompt": "Answer:",
                    "location": "sidebar",
                    "type": "radio",
                    "options": [
                    "1830–1852",
                    "1850–1962",
                    "1910–1955",
                    "1910–1995",
                    "Not sure",
                    "None of the above"
                    ]
                }
            ]
        }
    },
"sequence": {
    "order": "fixed",
    "components": [
        "introduction",
        "first-question-set",
        "second-question-set"
        ]
    }
}
